# ============================================================
# .gitignore — spice (Python CLI Toolkit)
# ============================================================

# -----------------------------------------------
# Python
# -----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
*.whl

# Virtual environments
venv/
.venv/
env/
ENV/

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml
*.cover

# mypy / type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# -----------------------------------------------
# Environment variables
# -----------------------------------------------
.env
.env.*
!.env.example

# -----------------------------------------------
# IDEs & Editors
# -----------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# -----------------------------------------------
# OS generated files
# -----------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------
# Logs
# -----------------------------------------------
*.log
logs/

# -----------------------------------------------
# Temporary files
# -----------------------------------------------
*.tmp
*.bak
*.orig
